// =============================================================================
// PERMANENT -- create-vcf-indexes (JobType.PERMANENT)
//
// Creates VCF index files (vcfIndex.tsv, SampleIds.csv) from genomic data in the
// populated RDS database. Reads every genomic study marked ready in managed inputs,
// queries consents/participants/samples per study, and writes index files for VCF
// processing.
//
// This job runs AFTER the database has been populated and global AllConcepts have
// been generated. It is triggered by the permanent orchestrator's "Create VCF indexes"
// stage (/Jenkinsfile) or can be run standalone.
//
// Inputs
//   --output       where vcfIndex.tsv and SampleIds.csv are written (local path or s3:// URI)
//   Managed inputs URI from configuration
//   RDS credentials read by the runner at boot from the SSM parameter
//                   /hpds-etl/<ENV>/participant-db/app-credentials, written by participant-db-start
//
// Outputs
//   vcfIndex.tsv and SampleIds.csv at the --output location
//   create-vcf-indexes-<runId>.json report with studiesProcessed, consentGroupsProcessed,
//   totalSamples, outputFiles, skippedStudies, heldBackGroups and heldBackFilesDeleted.
//
// Held-back consent groups
//   A consent group whose data would produce unparseable files (a sample id containing a
//   comma, tab or line break: ID_COUNT_MISMATCH; a study abbreviation containing a comma or
//   line break, which holds back every group of that study: BAD_STUDY_ABV) is not written, and
//   its previously published _vcfIndex.tsv / _SampleIds.csv, where they exist, are DELETED so
//   stale data cannot be read beside this run's groups (the versioned bucket keeps the old
//   versions; with a group to hold back, an s3:// output on a bucket without versioning Enabled
//   fails the run with exit 5 before anything is written or deleted). Every good group is still written. Each held-back group is an output-validation
//   error (exit 2), listed in metrics.heldBackGroups with its study, consent, reasons, a sample of
//   the bad ids and the deletedFiles URIs (count: metrics.heldBackFilesDeleted), and validate.sh
//   prints them. NO_FILES_WRITTEN is an error only when nothing at all was written.
//
// Exit codes (see ExitCode.java)
//   0 success | 2 validation (incl. held-back consent groups) | 3 data | 4 infrastructure |
//   5 config | 1 unknown | 124 monitor timeout
//
// Runner image
//   Standalone, this build compiles the JAR and builds, saves and uploads its own runner image.
//   The permanent orchestrator (/Jenkinsfile) builds the image once and passes it as
//   PREBUILT_IMAGE_TAR; this build then skips both build stages, uses that tarball, and leaves
//   deleting it to the orchestrator.
// =============================================================================

pipeline {
    agent any

    tools {
        jdk 'jdk-25'
    }

    options {
        timestamps()
        // Lets the orchestrators (/Jenkinsfile and Jenkinsfile.migration) copy this job's reports.
        copyArtifactPermission('*')
        buildDiscarder(logRotator(numToKeepStr: '50', artifactNumToKeepStr: '50'))
        disableConcurrentBuilds()
        timeout(time: 2, unit: 'HOURS')
    }

    parameters {
        string(name: 'OUTPUT', defaultValue: '',
               description: 'REQUIRED. --output: where vcfIndex.tsv and SampleIds.csv are written (local path or s3:// URI). Appends filenames if it ends with /.')
        string(name: 'MANAGED_INPUTS', defaultValue: '',
               description: '--managed-inputs: CSV listing studies to include (local path or s3:// URI). When blank the job falls back to etl.managed-inputs.uri from its config.')
        booleanParam(name: 'INCLUDE_PROCESSED', defaultValue: false,
               description: '--include-processed: also generate indexes for studies marked Data Processed in managed inputs. The migration pipeline sets this.')
        string(name: 'RUN_ID', defaultValue: '',
               description: 'Correlation id. Blank derives one from BUILD_NUMBER.')
        string(name: 'INSTANCE_TYPE', defaultValue: 'm5.large',
               description: 'Runner instance type.')
        string(name: 'JOB_TIMEOUT_SECONDS', defaultValue: '3600',
               description: 'How long to wait for the runner before giving up (monitor exits 124)')
        string(name: 'PREBUILT_IMAGE_TAR', defaultValue: '',
               description: 'Runner image tarball already under s3://<stack bucket>/etl-runner/container/ (the orchestrator sets this). Skips Build JAR and Package runner image, and the tarball is not deleted afterwards. Blank builds and uploads a fresh image.')
        booleanParam(name: 'SKIP_TESTS', defaultValue: false,
               description: 'Skip the JAR test suites.')
        booleanParam(name: 'RETRY_ON_INFRA', defaultValue: true,
               description: 'Retry once on exit 4 (INFRASTRUCTURE_ERROR).')
        booleanParam(name: 'PREFLIGHT_ONLY', defaultValue: false,
               description: 'Validate inputs and stop without provisioning anything')
        choice(name: 'ENV', choices: ['development'],
               description: 'Target environment. Selects etl-runners/environments/<ENV>.tfvars.')
    }

    environment {
        ENV             = "${params.ENV ?: 'development'}"
        AWS_REGION      = 'us-east-1'

        RUNNER_DIR = 'etl-runners/create-vcf-indexes'

        TF_VAR_output_uri                = "${params.OUTPUT.trim()}"
        TF_VAR_managed_inputs_uri        = "${params.MANAGED_INPUTS.trim()}"
        TF_VAR_include_processed         = "${params.INCLUDE_PROCESSED}"
        TF_VAR_instance_type             = "${params.INSTANCE_TYPE.trim()}"

        PIPELINE_TIMEOUT = "${params.JOB_TIMEOUT_SECONDS.trim()}"
    }

    stages {

        stage('Init') {
            steps {
                script {
                    if (!params.OUTPUT?.trim()) {
                        error('OUTPUT is required: the s3:// URI or local path for vcfIndex.tsv and SampleIds.csv.')
                    }

                    def base = (params.RUN_ID?.trim())
                        ?: "vcf-indexes-${env.BUILD_NUMBER}"
                    env.BASE_RUN_ID = base.replaceAll(/[^A-Za-z0-9._-]/, '-')
                    env.EFFECTIVE_RUN_ID = env.BASE_RUN_ID

                    env.TF_VAR_name_suffix = "vcf-indexes-${env.BUILD_NUMBER}".replaceAll(/[^A-Za-z0-9-]/, '-')

                    def prebuilt = params.PREBUILT_IMAGE_TAR?.trim()
                    if (prebuilt && !(prebuilt ==~ /[A-Za-z0-9._-]+\.tar\.gz/)) {
                        error("PREBUILT_IMAGE_TAR must be a tarball file name under etl-runner/container/, got '${prebuilt}'.")
                    }
                    env.USE_PREBUILT_IMAGE = prebuilt ? 'true' : 'false'
                    env.IMAGE_TAR = prebuilt ?: "hpds-etl-runner-${env.BASE_RUN_ID}.tar.gz"
                    env.TF_VAR_image_tar = env.IMAGE_TAR
                    echo "image:  ${env.IMAGE_TAR}" + (prebuilt ? ' (pre-built)' : ' (built by this job)')

                    currentBuild.displayName = "#${env.BUILD_NUMBER} vcf-indexes"
                    echo "output: ${params.OUTPUT}"
                    echo "run id: ${env.BASE_RUN_ID}"
                }
                sh '''
                    set -e
                    echo "--- tool versions ---"
                    make -s -C $RUNNER_DIR ensure-terraform
                    aws --version
                    docker --version
                    jq --version
                    java -version 2>&1 | head -1
                '''
            }
        }

        // Pre-flight needs no JAR, and a pre-built image already contains one.
        stage('Build JAR') {
            when { expression { env.USE_PREBUILT_IMAGE != 'true' && !params.PREFLIGHT_ONLY } }
            steps {
                sh "make -C ${RUNNER_DIR} jar SKIP_TESTS=${params.SKIP_TESTS}"
            }
            post {
                always {
                    junit testResults: 'target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Pre-flight') {
            steps {
                script {
                    env.TF_VAR_run_id = env.EFFECTIVE_RUN_ID
                    int rc = sh(script: "cd ${RUNNER_DIR} && ./preflight.sh", returnStatus: true)
                    if (rc == 10) {
                        unstable('Pre-flight found warnings')
                    } else if (rc != 0) {
                        error("Pre-flight failed (rc=${rc})")
                    }
                }
            }
        }

        stage('Package runner image') {
            when { expression { !params.PREFLIGHT_ONLY } }
            steps {
                script {
                    if (env.USE_PREBUILT_IMAGE == 'true') {
                        // Fail now rather than after provisioning an instance that cannot pull it.
                        int rc = sh(returnStatus: true, script: '''
                            bucket=$(sed -n 's/^stack_s3_bucket[[:space:]]*=[[:space:]]*"\\(.*\\)"/\\1/p' etl-runners/environments/$ENV.tfvars)
                            aws s3api head-object --bucket "$bucket" --key "etl-runner/container/$IMAGE_TAR" --region "$AWS_REGION" >/dev/null
                        ''')
                        if (rc != 0) {
                            error("Pre-built image ${env.IMAGE_TAR} is not in the stack bucket under etl-runner/container/.")
                        }
                        echo "Using pre-built image ${env.IMAGE_TAR}"
                    } else {
                        // Set first, so a partial upload is still cleaned up in post.
                        env.OWNS_IMAGE = 'true'
                        sh "make -C ${RUNNER_DIR} package IMAGE_TAR=${env.IMAGE_TAR}"
                    }
                }
            }
        }

        stage('Provision, run and monitor') {
            when { expression { !params.PREFLIGHT_ONLY } }
            steps {
                script {
                    // The participant DB is up only between participant-db-start and -stop.
                    // Fail here, in seconds, rather than after ~5 minutes of provisioning.
                    if (sh(returnStatus: true, script: "etl-runners/common/require-db.sh ${env.ENV}") != 0) {
                        error('The participant database is not running. Run participant-db-start (or run this job through an orchestrator), then retry.')
                    }

                    int maxAttempts = params.RETRY_ON_INFRA ? 2 : 1
                    int rc = 1

                    for (int attempt = 1; attempt <= maxAttempts; attempt++) {
                        env.EFFECTIVE_RUN_ID = (attempt == 1) ? env.BASE_RUN_ID
                                                              : "${env.BASE_RUN_ID}-r${attempt}"
                        env.TF_VAR_run_id = env.EFFECTIVE_RUN_ID
                        env.TF_VAR_name_suffix = "vcf-indexes-${env.BUILD_NUMBER}-${attempt}".replaceAll(/[^A-Za-z0-9-]/, '-')
                        env.STATE_KEY = "tf_backend/etl-runners/hpds-etl/create-vcf-indexes/${env.EFFECTIVE_RUN_ID}.tfstate"

                        echo "Attempt ${attempt}/${maxAttempts} -- run id ${env.EFFECTIVE_RUN_ID}"

                        sh "make -C ${RUNNER_DIR} init apply STATE_KEY=${env.STATE_KEY}"
                        env.TF_INITIALISED = 'true'

                        rc = sh(returnStatus: true, script: """
                            cd ${RUNNER_DIR}
                            TF=\$(make -s tf-path)
                            ../common/monitor-runner.sh \
                              "\$(\$TF -chdir=terraform output -raw instance_id)" \
                              "\$(\$TF -chdir=terraform output -raw status_s3_uri)" \
                              "\$(\$TF -chdir=terraform output -raw log_s3_uri)"
                        """)

                        env.JOB_EXIT_CODE = "${rc}"
                        if (rc != 4 || attempt == maxAttempts) {
                            break
                        }

                        echo "Exit 4 (INFRASTRUCTURE_ERROR) is retryable -- tearing down and retrying"
                        sh(returnStatus: true,
                           script: "make -C ${RUNNER_DIR} destroy STATE_KEY=${env.STATE_KEY}")
                        sleep time: 60, unit: 'SECONDS'
                    }

                    if (rc != 0) {
                        String meaning = [
                            1  : 'UNKNOWN (unclassified failure)',
                            2  : 'VALIDATION_FAILED (no ready studies or empty output)',
                            3  : 'DATA_ERROR (no samples or indexes generated)',
                            4  : 'INFRASTRUCTURE_ERROR (RDS/S3/network)',
                            5  : 'CONFIG_ERROR (missing or invalid parameter/credential)',
                            124: 'TIMEOUT (runner did not finish in time)',
                        ].get(rc, "unmapped code ${rc}")
                        env.FAILURE_MEANING = meaning
                        echo "Job exited ${rc}: ${meaning}"
                    }
                }
            }
        }

        stage('Fetch reports') {
            when { expression { !params.PREFLIGHT_ONLY && env.TF_INITIALISED == 'true' } }
            steps {
                sh "make -C ${RUNNER_DIR} fetch-reports STATE_KEY=${env.STATE_KEY}"
            }
        }

        stage('Validate') {
            when { expression { !params.PREFLIGHT_ONLY && env.TF_INITIALISED == 'true' } }
            steps {
                script {
                    // A job that stopped before writing its report (a timeout, a crash, the instance lost)
                    // leaves validate.sh nothing to check. Report the job's failure, not the missing file.
                    String reportFile = "${RUNNER_DIR}/reports/create-vcf-indexes-${env.EFFECTIVE_RUN_ID}.json"
                    if (env.JOB_EXIT_CODE != '0' && !fileExists(reportFile)) {
                        env.FAILURE_REASON = "${env.FAILURE_MEANING}; it stopped before writing its report, so there was nothing to validate"
                        error("Job failed: ${env.FAILURE_REASON}. The runner log above shows how far it got.")
                    }
                    int rc = sh(returnStatus: true, script:
                        "cd ${RUNNER_DIR} && ./validate.sh reports ${env.EFFECTIVE_RUN_ID}")

                    if (env.JOB_EXIT_CODE != '0') {
                        env.FAILURE_REASON = env.FAILURE_MEANING
                        error("Job failed: ${env.FAILURE_MEANING}. The report checks above show what it recorded.")
                    }
                    if (rc == 10) {
                        unstable('Validation passed with warnings')
                    } else if (rc != 0) {
                        env.FAILURE_REASON = "report validation failed (rc=${rc})"
                        error("Report validation failed (rc=${rc}): the job exited 0 but its output does not hold up")
                    }
                    echo "VCF indexes generated and validated."
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "${RUNNER_DIR}/reports/**",
                             allowEmptyArchive: true, fingerprint: true
            script {
                if (env.TF_INITIALISED == 'true') {
                    int rc = sh(returnStatus: true,
                                script: "make -C ${RUNNER_DIR} destroy STATE_KEY=${env.STATE_KEY}")
                    if (rc != 0) {
                        echo "WARNING: terraform destroy returned ${rc}."
                    }
                }
                // Only an image this build uploaded; a pre-built one belongs to the orchestrator.
                if (env.OWNS_IMAGE == 'true') {
                    sh(returnStatus: true, script: """
                        aws s3 rm s3://\$(sed -n 's/^stack_s3_bucket[[:space:]]*=[[:space:]]*"\\(.*\\)"/\\1/p' \
                          etl-runners/environments/${ENV}.tfvars)/etl-runner/container/${env.IMAGE_TAR} \
                          --region ${AWS_REGION} || true
                    """)
                    // The local tarball and image make package left on this host.
                    sh(returnStatus: true, script: '''
                        rm -f "$RUNNER_DIR/$IMAGE_TAR"
                        docker rmi "${IMAGE_TAR%.tar.gz}" >/dev/null 2>&1 || true
                    ''')
                }
            }
        }
        failure {
            script {
                // Read by the orchestrators, which quote it when this build fails their stage.
                currentBuild.description = env.FAILURE_REASON ?: env.FAILURE_MEANING ?:
                    (env.JOB_EXIT_CODE ? 'the job ran, then a later step failed; see the console' : 'failed before the job ran; see the console')
            }
            echo "create-vcf-indexes FAILED: ${currentBuild.description}. Reports are archived on this build."
        }
        unstable {
            echo 'create-vcf-indexes completed WITH WARNINGS. ' +
                 'Check for studies with missing genomic data.'
        }
        success {
            echo "VCF indexes generated (run ${env.EFFECTIVE_RUN_ID})."
        }
    }
}
