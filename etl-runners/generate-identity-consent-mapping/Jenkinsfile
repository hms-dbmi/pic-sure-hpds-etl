// Generate the harmonized-data consent mapping file (ALS-12727).
//
// Runs generate_identity_consent_mapping.py on the Jenkins agent itself —
// no EC2 provisioning, no Docker. All AWS access is read-only under the
// role passed in ROLE_ARN (sts assume-role, s3 ls, s3 cp streamed).
// The CSV output is archived as a build artifact; staging it onward
// (S3 vs RDS) is decided on the ticket.

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    parameters {
        string(name: 'ROLE_ARN',
               defaultValue: 'arn:aws:iam::714862078411:role/nih-nhlbi-TopMed-EC2Access-S3',
               description: 'IAM role assumed for all S3 reads (same role name in both NHLBI accounts)')
        string(name: 'S3_BASE',
               defaultValue: 's3://nih-nhlbi-bdc-harmdata-exchange',
               description: 'Bucket holding the DMC harmonization example drops')
        string(name: 'DATASET_PREFIX',
               defaultValue: '',
               description: 'Drop to ingest, e.g. BDC-DMC-Harmonization-Examples-20260804; blank = latest by date (deterministic)')
        booleanParam(name: 'PER_STUDY',
               defaultValue: false,
               description: 'Write one CSV per study instead of a single combined file')
    }

    stages {
        stage('Preflight') {
            steps {
                sh '''
                    set -e
                    aws --version
                    python3 --version
                    [ -n "$ROLE_ARN" ] || { echo "ROLE_ARN is required" >&2; exit 1; }
                    python3 "etl-runners/generate-identity-consent-mapping/generate_identity_consent_mapping.py" --selftest
                '''
            }
        }

        stage('Generate') {
            steps {
                sh '''
                    set -e
                    rm -rf output && mkdir -p output
                    ARGS="--role-arn $ROLE_ARN --s3-base $S3_BASE --output-dir output"
                    [ -n "$DATASET_PREFIX" ] && ARGS="$ARGS --dataset-prefix $DATASET_PREFIX"
                    [ "$PER_STUDY" = "true" ] && ARGS="$ARGS --per-study"
                    python3 "etl-runners/generate-identity-consent-mapping/generate_identity_consent_mapping.py" $ARGS
                '''
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'output/*.csv', fingerprint: true
        }
    }
}
