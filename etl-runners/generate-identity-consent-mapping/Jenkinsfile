// =============================================================================
// PERMANENT -- generate-identity-consent-mapping (JobType.PERMANENT)
//
// Generates the harmonized-data consent mapping file (ALS-12727): one row of
// Person.Identity,study_id,consent_code per identity value in each consent
// group's Person.tsv of a DMC harmonization drop. Study and consent come from
// the consent-group directory names; with no DATASET_PREFIX the newest
// BDC-DMC-Harmonization-Examples-YYYYMMDD drop is selected deterministically.
//
// Standalone job (not part of the orchestrator DAG): run it when a new DMC drop
// lands. Touches no database. Input reads happen in-process under ROLE_ARN
// (the NHLBI exchange role); output writes go through the container's default
// credentials (CONTAINER_ASSUME_ROLE_ARN, dbgap-etl).
//
// Inputs
//   --base            bucket/prefix holding the DMC drops
//   --dataset-prefix  pin one drop; blank = latest by date
//   --role-arn        role assumed in-process for all reads of the base
//   --output          where the mapping CSV(s) are written
//   --per-study       one CSV per study instead of a single combined file
//
// Outputs
//   identity_consent_mapping.csv (or identity_consent_mapping_<phs>.csv per
//   study) at the OUTPUT location. NOTE: the default OUTPUT prefix is a
//   TEMPORARY location until the staging decision (S3 vs RDS) settles on the
//   ticket. generate-identity-consent-mapping-<runId>.json report with
//   consentGroups, rows, blankIdentityRows, inGroupDuplicates,
//   crossConsentIdentities.
//
// Exit codes (see ExitCode.java)
//   0 success | 2 validation | 3 data | 4 infrastructure | 5 config | 1 unknown |
//   124 monitor timeout
// =============================================================================

pipeline {
    agent any

    tools {
        jdk 'jdk-25'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '50', artifactNumToKeepStr: '50'))
        disableConcurrentBuilds()
        timeout(time: 2, unit: 'HOURS')
    }

    parameters {
        string(name: 'S3_BASE', defaultValue: 's3://nih-nhlbi-bdc-harmdata-exchange',
               description: '--base: bucket/prefix holding the DMC harmonization drops.')
        string(name: 'DATASET_PREFIX', defaultValue: '',
               description: '--dataset-prefix: pin one drop, e.g. BDC-DMC-Harmonization-Examples-20260804. Blank = latest by date (deterministic).')
        string(name: 'ROLE_ARN', defaultValue: 'arn:aws:iam::714862078411:role/nih-nhlbi-TopMed-EC2Access-S3',
               description: '--role-arn: IAM role the job assumes in-process for all reads of the base (same role name in both NHLBI accounts).')
        string(name: 'OUTPUT', defaultValue: 's3://avillach-73-bdcatalyst-etl/dmcharmonizedexamples/output/',
               description: '--output: where the mapping CSV(s) are written. The default prefix is TEMPORARY until the staging decision (S3 vs RDS) settles on ALS-12727.')
        booleanParam(name: 'PER_STUDY', defaultValue: false,
               description: '--per-study: one CSV per study instead of a single combined file.')
        string(name: 'RUN_ID', defaultValue: '',
               description: 'Correlation id. Blank derives one from BUILD_NUMBER.')
        string(name: 'INSTANCE_TYPE', defaultValue: 'm5.large',
               description: 'Runner instance type.')
        string(name: 'JOB_TIMEOUT_SECONDS', defaultValue: '1800',
               description: 'How long to wait for the runner before giving up (monitor exits 124)')
        booleanParam(name: 'SKIP_TESTS', defaultValue: false,
               description: 'Skip the JAR test suites.')
        booleanParam(name: 'RETRY_ON_INFRA', defaultValue: true,
               description: 'Retry once on exit 4 (INFRASTRUCTURE_ERROR).')
        string(name: 'CONTAINER_ASSUME_ROLE_ARN', defaultValue: 'arn:aws:iam::736265540791:role/dbgap-etl',
               description: 'Cross-account IAM role ARN for the container default credential chain (used for the output writes). Blank disables cross-account access.')
        booleanParam(name: 'PREFLIGHT_ONLY', defaultValue: false,
               description: 'Validate inputs and stop without provisioning anything')
        choice(name: 'ENV', choices: ['integration'],
               description: 'Target environment. Selects etl-runners/environments/<ENV>.tfvars.')
    }

    environment {
        ENV             = "${params.ENV ?: 'integration'}"
        AWS_REGION      = 'us-east-1'
        AWS_CONFIG_FILE = "${WORKSPACE}/.aws-config"

        RUNNER_DIR = 'etl-runners/generate-identity-consent-mapping'

        TF_VAR_base_uri                  = "${params.S3_BASE.trim()}"
        TF_VAR_dataset_prefix            = "${params.DATASET_PREFIX.trim()}"
        TF_VAR_input_role_arn            = "${params.ROLE_ARN.trim()}"
        TF_VAR_output_uri                = "${params.OUTPUT.trim()}"
        TF_VAR_per_study                 = "${params.PER_STUDY}"
        TF_VAR_container_assume_role_arn = "${params.CONTAINER_ASSUME_ROLE_ARN.trim()}"
        TF_VAR_instance_type             = "${params.INSTANCE_TYPE.trim()}"

        PIPELINE_TIMEOUT = "${params.JOB_TIMEOUT_SECONDS.trim()}"
    }

    stages {

        stage('Init') {
            steps {
                // Two agent-side profiles: dbgap-etl for the output bucket checks,
                // nhlbi-exchange (the ROLE_ARN param) for the exchange bucket checks.
                sh '''
                    cat > "$AWS_CONFIG_FILE" <<EOF
[profile dbgap-etl]
role_arn = arn:aws:iam::736265540791:role/dbgap-etl
credential_source = Ec2InstanceMetadata
role_session_name = jenkins-hpds-etl

[profile nhlbi-exchange]
role_arn = $TF_VAR_input_role_arn
credential_source = Ec2InstanceMetadata
role_session_name = jenkins-hpds-etl
EOF
                '''
                script {
                    if (!params.OUTPUT?.trim()) {
                        error('OUTPUT is required: the s3:// URI or local path for the mapping CSV(s).')
                    }
                    if (!params.ROLE_ARN?.trim()) {
                        error('ROLE_ARN is required: the exchange bucket is not readable by the default principal.')
                    }

                    def base = (params.RUN_ID?.trim())
                        ?: "identity-mapping-${env.BUILD_NUMBER}"
                    env.BASE_RUN_ID = base.replaceAll(/[^A-Za-z0-9._-]/, '-')
                    env.EFFECTIVE_RUN_ID = env.BASE_RUN_ID

                    env.TF_VAR_name_suffix = "identity-mapping-${env.BUILD_NUMBER}".replaceAll(/[^A-Za-z0-9-]/, '-')

                    env.IMAGE_TAR = "hpds-etl-runner-${env.BASE_RUN_ID}.tar.gz"
                    env.TF_VAR_image_tar = env.IMAGE_TAR

                    currentBuild.displayName = "#${env.BUILD_NUMBER} identity-mapping"
                    echo "base: ${params.S3_BASE}"
                    echo "dataset: ${params.DATASET_PREFIX ?: '<latest by date>'}"
                    echo "output: ${params.OUTPUT}"
                    echo "run id: ${env.BASE_RUN_ID}"
                }
                sh '''
                    set -e
                    echo "--- tool versions ---"
                    make -s -C $RUNNER_DIR ensure-terraform
                    aws --version
                    docker --version
                    jq --version
                    java -version 2>&1 | head -1
                '''
            }
        }

        stage('Build JAR') {
            steps {
                sh "make -C ${RUNNER_DIR} jar SKIP_TESTS=${params.SKIP_TESTS}"
            }
            post {
                always {
                    junit testResults: 'target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Pre-flight') {
            steps {
                script {
                    env.TF_VAR_run_id = env.EFFECTIVE_RUN_ID
                    withEnv(['AWS_PROFILE=dbgap-etl']) {
                        int rc = sh(script: "cd ${RUNNER_DIR} && ./preflight.sh", returnStatus: true)
                        if (rc == 10) {
                            unstable('Pre-flight found warnings')
                        } else if (rc != 0) {
                            error("Pre-flight failed (rc=${rc})")
                        }
                    }
                }
            }
        }

        stage('Package runner image') {
            when { expression { !params.PREFLIGHT_ONLY } }
            steps {
                sh "make -C ${RUNNER_DIR} package IMAGE_TAR=${env.IMAGE_TAR}"
            }
        }

        stage('Provision, run and monitor') {
            when { expression { !params.PREFLIGHT_ONLY } }
            steps {
                script {
                    int maxAttempts = params.RETRY_ON_INFRA ? 2 : 1
                    int rc = 1

                    for (int attempt = 1; attempt <= maxAttempts; attempt++) {
                        env.EFFECTIVE_RUN_ID = (attempt == 1) ? env.BASE_RUN_ID
                                                              : "${env.BASE_RUN_ID}-r${attempt}"
                        env.TF_VAR_run_id = env.EFFECTIVE_RUN_ID
                        env.TF_VAR_name_suffix = "identity-mapping-${env.BUILD_NUMBER}-${attempt}".replaceAll(/[^A-Za-z0-9-]/, '-')
                        env.STATE_KEY = "tf_backend/etl-runners/hpds-etl/generate-identity-consent-mapping/${env.EFFECTIVE_RUN_ID}.tfstate"

                        echo "Attempt ${attempt}/${maxAttempts} -- run id ${env.EFFECTIVE_RUN_ID}"

                        sh "make -C ${RUNNER_DIR} init apply STATE_KEY=${env.STATE_KEY}"
                        env.TF_INITIALISED = 'true'

                        rc = sh(returnStatus: true, script: """
                            cd ${RUNNER_DIR}
                            TF=\$(make -s tf-path)
                            ../common/monitor-runner.sh \
                              "\$(\$TF -chdir=terraform output -raw instance_id)" \
                              "\$(\$TF -chdir=terraform output -raw status_s3_uri)" \
                              "\$(\$TF -chdir=terraform output -raw log_s3_uri)"
                        """)

                        env.JOB_EXIT_CODE = "${rc}"
                        if (rc != 4 || attempt == maxAttempts) {
                            break
                        }

                        echo "Exit 4 (INFRASTRUCTURE_ERROR) is retryable -- tearing down and retrying"
                        sh(returnStatus: true,
                           script: "make -C ${RUNNER_DIR} destroy STATE_KEY=${env.STATE_KEY}")
                        sleep time: 60, unit: 'SECONDS'
                    }

                    if (rc != 0) {
                        String meaning = [
                            1  : 'UNKNOWN (unclassified failure)',
                            2  : 'VALIDATION_FAILED (empty mapping or bad parameter)',
                            3  : 'DATA_ERROR (unreadable Person.tsv)',
                            4  : 'INFRASTRUCTURE_ERROR (S3/network)',
                            5  : 'CONFIG_ERROR (no dataset found, missing parameter, or role assumption failed)',
                            124: 'TIMEOUT (runner did not finish in time)',
                        ].get(rc, "unmapped code ${rc}")
                        env.FAILURE_MEANING = meaning
                        echo "Job exited ${rc}: ${meaning}"
                    }
                }
            }
        }

        stage('Fetch reports') {
            when { expression { !params.PREFLIGHT_ONLY && env.TF_INITIALISED == 'true' } }
            steps {
                sh "make -C ${RUNNER_DIR} fetch-reports STATE_KEY=${env.STATE_KEY}"
            }
        }

        stage('Validate') {
            when { expression { !params.PREFLIGHT_ONLY && env.TF_INITIALISED == 'true' } }
            steps {
                script {
                    int rc
                    withEnv(['AWS_PROFILE=dbgap-etl']) {
                        rc = sh(returnStatus: true, script:
                            "cd ${RUNNER_DIR} && ./validate.sh reports ${env.EFFECTIVE_RUN_ID}")
                    }

                    if (env.JOB_EXIT_CODE != '0') {
                        error("Job failed: ${env.FAILURE_MEANING}. See the validation output above.")
                    }
                    if (rc == 10) {
                        unstable('Validation passed with warnings')
                    } else if (rc != 0) {
                        error("Report validation failed (rc=${rc}): the job exited 0 but its output does not hold up")
                    }
                    echo "Identity consent mapping generated and validated."
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "${RUNNER_DIR}/reports/**",
                             allowEmptyArchive: true, fingerprint: true
            script {
                if (env.TF_INITIALISED == 'true') {
                    int rc = sh(returnStatus: true,
                                script: "make -C ${RUNNER_DIR} destroy STATE_KEY=${env.STATE_KEY}")
                    if (rc != 0) {
                        echo "WARNING: terraform destroy returned ${rc}."
                    }
                }
                if (env.IMAGE_TAR) {
                    sh(returnStatus: true, script: """
                        aws s3 rm s3://\$(sed -n 's/^stack_s3_bucket[[:space:]]*=[[:space:]]*"\\(.*\\)"/\\1/p' \
                          etl-runners/environments/${ENV}.tfvars)/etl-runner/container/${env.IMAGE_TAR} \
                          --region ${AWS_REGION} || true
                    """)
                }
            }
        }
        failure {
            echo "generate-identity-consent-mapping FAILED at stage '${env.STAGE_NAME}'. " +
                 "${env.FAILURE_MEANING ?: ''} Reports are archived on this build."
        }
        unstable {
            echo 'generate-identity-consent-mapping completed WITH WARNINGS. ' +
                 'Check for identities spanning consent groups of one study.'
        }
        success {
            echo "Identity consent mapping generated (run ${env.EFFECTIVE_RUN_ID})."
        }
    }
}
