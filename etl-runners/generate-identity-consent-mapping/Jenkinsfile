// Generate the harmonized-data consent mapping file (ALS-12727).
//
// Runs the generate-identity-consent-mapping ETL job on the Jenkins agent
// itself — no EC2 provisioning, no Docker. All AWS access is read-only under
// the role passed in ROLE_ARN (sts assume-role, s3 list/get). The CSV output
// and the run's JSON report are archived as build artifacts; staging the
// mapping onward (S3 vs RDS) is decided on the ticket.

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    parameters {
        string(name: 'ROLE_ARN',
               defaultValue: 'arn:aws:iam::714862078411:role/nih-nhlbi-TopMed-EC2Access-S3',
               description: 'IAM role assumed for all S3 reads (same role name in both NHLBI accounts)')
        string(name: 'S3_BASE',
               defaultValue: 's3://nih-nhlbi-bdc-harmdata-exchange',
               description: 'Bucket holding the DMC harmonization example drops')
        string(name: 'DATASET_PREFIX',
               defaultValue: '',
               description: 'Drop to ingest, e.g. BDC-DMC-Harmonization-Examples-20260804; blank = latest by date (deterministic)')
        booleanParam(name: 'PER_STUDY',
               defaultValue: false,
               description: 'Write one CSV per study instead of a single combined file')
    }

    stages {
        stage('Build') {
            steps {
                sh '''
                    set -e
                    [ -n "$ROLE_ARN" ] || { echo "ROLE_ARN is required" >&2; exit 1; }
                    ./mvnw -B -q test -Dtest=GenerateIdentityConsentMappingJobTest
                    ./mvnw -B -q package -DskipTests
                '''
            }
        }

        stage('Generate') {
            steps {
                sh '''
                    set -e
                    rm -rf output reports && mkdir -p output reports
                    ARGS="--base=$S3_BASE --role-arn=$ROLE_ARN --output=output"
                    [ -n "$DATASET_PREFIX" ] && ARGS="$ARGS --dataset-prefix=$DATASET_PREFIX"
                    [ "$PER_STUDY" = "true" ] && ARGS="$ARGS --per-study=true"
                    java -jar target/hpds-etl.jar --job=generate-identity-consent-mapping $ARGS
                '''
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'output/*.csv, reports/**', fingerprint: true
        }
    }
}
