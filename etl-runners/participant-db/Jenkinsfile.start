// =============================================================================
// SHARED -- participant-db-start
//
// Makes sure the participant database (participants / consents / samples) is up, then saves its
// connection details to a 600-mode file on this Jenkins server (etl-runners/common/
// db-credentials-path.sh), which the DB-backed runner jobs read.
//
// The database is a long-lived PostgreSQL 16 container on the Jenkins host (started through the
// host's podman socket), with its data in a named volume. It is NOT torn down between runs;
// participant-db-backup dumps it to S3 at the end of every pipeline run. See start.sh and
// docs/PARTICIPANT_DB.md for the full rules. In short:
//
//   up and clean                  kept as-is
//   OVERWRITE=true                saved to participant_db_pre_overwrite.tar, then replaced with
//                                 RESTORE_FROM (blank = the latest clean backup), whether or not
//                                 it was up
//   last run failed               IF_LAST_RUN_FAILED=restore-clean (default): replaced from the
//                                 clean backup, saved first. =continue: kept with that run's data
//   not PostgreSQL 16             saved, recreated on 16, and restored from that save
//   not up                        created from RESTORE_FROM, else the latest clean backup
//
// Dumps: s3://bdc-etl-data-d0d6191/avillach-73-bdcatalyst-etl/participant-db/<ENV>/backups/
// =============================================================================

pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '50'))
        disableConcurrentBuilds()
        // A replace dumps the live database first, then restores; both scale with its size.
        timeout(time: 4, unit: 'HOURS')
    }

    parameters {
        booleanParam(name: 'OVERWRITE', defaultValue: false,
               description: 'Replace the database with RESTORE_FROM (blank = the latest clean backup, participant_db.tar), whether or not one is already up. A running database is first saved to participant_db_pre_overwrite.tar.')
        string(name: 'RESTORE_FROM', defaultValue: '',
               description: 'What a new or replaced database is loaded from. Blank: the latest clean backup. "none": a fresh empty schema. Otherwise a file under backups/ (participant_db_not_promoted.tar, participant_db_pre_overwrite.tar, ...) or a full s3:// URI to a tarred pg_dump --format=d dump. Ignored when the database is up and OVERWRITE is false.')
        choice(name: 'IF_LAST_RUN_FAILED', choices: ['restore-clean', 'continue'],
               description: 'When the last pipeline run failed (its writes are still in the live database): restore-clean replaces it from the latest clean backup (the failed state is already saved as participant_db_not_promoted.tar); continue keeps working on it.')
        string(name: 'RUN_ID', defaultValue: '',
               description: 'Correlation id. Blank derives one from BUILD_NUMBER; orchestrators pass their BUILD_TAG.')
        choice(name: 'ENV', choices: ['development'],
               description: 'Target environment. Selects etl-runners/environments/<ENV>.tfvars.')
    }

    environment {
        ENV        = "${params.ENV ?: 'development'}"
        AWS_REGION = 'us-east-1'
    }

    stages {
        stage('Start') {
            steps {
                script {
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${env.ENV}" + (params.OVERWRITE ? ' (overwrite)' : '')
                }
                withEnv(["OVERWRITE=${params.OVERWRITE}",
                         "RESTORE_FROM=${params.RESTORE_FROM?.trim() ?: ''}",
                         "IF_LAST_RUN_FAILED=${params.IF_LAST_RUN_FAILED}"]) {
                    sh 'etl-runners/participant-db/start.sh "$ENV"'
                }
            }
        }

        stage('Verify') {
            steps {
                sh 'etl-runners/common/require-db.sh "$ENV"'
            }
        }
    }

    post {
        success {
            echo "Participant database is up in '${env.ENV}'. It stays up; participant-db-backup saves it at the end of each pipeline run."
        }
        failure {
            echo 'participant-db-start FAILED. If the log says the database was replaced but not brought back up, ' +
                 'its previous contents are in participant_db_pre_overwrite.tar: re-run with OVERWRITE=true ' +
                 'RESTORE_FROM=participant_db_pre_overwrite.tar.'
        }
    }
}
