// =============================================================================
// TEMPORARY -- adapt-allconcepts-csvloader (JobType.MIGRATION)
//
// A bridge, not part of either orchestrator: reads the per-study allConcepts layout (the versioned
// allConcepts_manifest.csv with one file per {study}.c{code} and the global file) and writes the flat
// <partition>-allConcepts.csv files plus split_manifest.json that the in-boundary runner hpds-pheno-load
// (flow csvloader-split) and the stock pic-sure CSVLoader accept. Delete this runner with the job once the
// per-study pipeline writes that layout itself. See docs/ADAPT_ALLCONCEPTS_CSVLOADER.md.
//
// Touches no database (uses_participant_db stays false) and has no orchestrator stage: run it by hand
// from this job, then start hpds-pheno-load with SPLIT_URI=<OUTPUT>.
//
// Inputs
//   --manifest            allConcepts_manifest.csv (s3://, versioned bucket)
//   --output              EMPTY s3:// prefix for the result; never under avillach-73-bdcatalyst-etl
//   --studies             optional: only these study ids
//   --max-reject-fraction share of input rows that may be rejected (default 0)
//   --allow-consent-codes consent codes accepted although they are not positive integers
//   --multi-study-ids     copy (default) | refuse
//   --foreign-study-rows  reject (default) | drop: STOPGAP, a data row under another study's tree is dropped with a warning
//                         instead of rejected (never loaded either way)
//   --unmatched-consent-rows  reject (default) | drop: STOPGAP, a global _consents row naming no manifest partition
//                         (for example consent code 0) is dropped with a warning instead of rejected
//
// Outputs (under OUTPUT, split_manifest.json last)
//   <partition>-allConcepts.csv, split_manifest.json, report.json, rejects/<partition>.csv when any
//   adapt-allconcepts-csvloader-<runId>.json (the JobResult) in the reports
//   A failed run leaves OUTPUT empty and its report in the reports.
//
// Exit codes (see ExitCode.java)
//   0 success (UNSTABLE when anything was dropped or rejected within the fraction) | 2 validation (output under the legacy bucket or not empty, bad parameter, manifest or
//   partition name refused) | 3 data (md5 mismatch, manifest moved during the run, ids not patient-level,
//   too many rejects, an empty partition) | 4 infrastructure (retried once when RETRY_ON_INFRA) |
//   5 config (a missing input) | 124 monitor timeout (not retried)
//
// Runner disk
//   The output is built on the runner before anything is uploaded, so the root volume (ROOT_VOLUME_GB)
//   must hold the whole output (pre-flight checks 2 x the in-scope input + 10 GiB). The default 500 GiB fits a proof
//   of concept of a few partitions, not a full manifest; the gp3 throughput default (125 MiB/s) bounds a full run.
// =============================================================================

pipeline {
    agent any

    tools {
        jdk 'jdk-25'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '50', artifactNumToKeepStr: '50'))
        disableConcurrentBuilds()
        timeout(time: 9, unit: 'HOURS') // keep BUILD_TIMEOUT_HOURS below in step
    }

    parameters {
        string(name: 'MANIFEST', defaultValue: '',
               description: 'REQUIRED. --manifest: s3:// URI of allConcepts_manifest.csv (versioned bucket).')
        string(name: 'OUTPUT', defaultValue: '',
               description: 'REQUIRED. --output: EMPTY s3:// prefix that receives the split layout. Never under avillach-73-bdcatalyst-etl.')
        string(name: 'STUDIES', defaultValue: '',
               description: 'Optional comma-separated study ids to adapt instead of every study of the manifest.')
        string(name: 'MAX_REJECT_FRACTION', defaultValue: '0',
               description: '--max-reject-fraction: share (0-1) of the input rows that may be rejected before the run fails.')
        string(name: 'ALLOW_CONSENT_CODES', defaultValue: '',
               description: '--allow-consent-codes: comma-separated consent codes accepted although they are not positive integers (for example 0,public).')
        choice(name: 'MULTI_STUDY_IDS', choices: ['copy', 'refuse'],
               description: '--multi-study-ids: copy source ids of patients in several studies to every partition they hold (when patient-level), or refuse such patients.')
        choice(name: 'FOREIGN_STUDY_ROWS', choices: ['reject', 'drop'],
               description: '--foreign-study-rows: what to do with a data row whose first node is another study than its partition (the generator selects rows by participant, not by study, so a participant in two studies drags the other study\'s rows in). reject: counted as STUDY_PARTITION_MISMATCH and fails the run unless MAX_REJECT_FRACTION allows it. drop: a STOPGAP, counted as dropped with a warning per partition (UNSTABLE build). Either way the rows are NEVER loaded.')
        choice(name: 'UNMATCHED_CONSENT_ROWS', choices: ['reject', 'drop'],
               description: '--unmatched-consent-rows: what to do with a global _consents row naming no partition of the manifest (for example consent code 0 = no consent). reject: counted as CONSENT_NOT_IN_MANIFEST. drop: a STOPGAP, counted as dropped with a warning (UNSTABLE build). Either way the rows are NEVER loaded.')
        string(name: 'RUN_ID', defaultValue: '',
               description: 'Correlation id. Blank derives one from BUILD_NUMBER.')
        string(name: 'INSTANCE_TYPE', defaultValue: 'c5.xlarge',
               description: 'Runner instance type.')
        string(name: 'ROOT_VOLUME_GB', defaultValue: '500',
               description: 'Root volume of the runner in GiB. The whole output is built on it before upload. The default 500 fits a proof of concept of a few partitions, NOT a full manifest; pre-flight refuses when 2 x the in-scope input + 10 GiB does not fit. The gp3 default of 125 MiB/s bounds the speed of a full run.')
        string(name: 'JOB_TIMEOUT_SECONDS', defaultValue: '14400',
               description: 'How long to wait for the runner before giving up (monitor exits 124). A retry gets at most what is left of the 9h build timeout.')
        booleanParam(name: 'SKIP_TESTS', defaultValue: false,
               description: 'Skip the JAR test suites.')
        booleanParam(name: 'RETRY_ON_INFRA', defaultValue: true,
               description: 'Retry once on exit 4 (INFRASTRUCTURE_ERROR).')
        choice(name: 'ENV', choices: ['development'],
               description: 'Target environment. Selects etl-runners/environments/<ENV>.tfvars.')
    }

    environment {
        ENV             = "${params.ENV ?: 'development'}"
        AWS_REGION      = 'us-east-1'

        RUNNER_DIR = 'etl-runners/adapt-allconcepts-csvloader'

        TF_VAR_manifest_uri              = "${params.MANIFEST.trim()}"
        TF_VAR_output_uri                = "${params.OUTPUT.trim()}"
        TF_VAR_studies                   = "${params.STUDIES.trim()}"
        TF_VAR_max_reject_fraction       = "${params.MAX_REJECT_FRACTION.trim()}"
        TF_VAR_allow_consent_codes       = "${params.ALLOW_CONSENT_CODES.trim()}"
        TF_VAR_multi_study_ids           = "${params.MULTI_STUDY_IDS}"
        TF_VAR_foreign_study_rows        = "${params.FOREIGN_STUDY_ROWS}"
        TF_VAR_unmatched_consent_rows    = "${params.UNMATCHED_CONSENT_ROWS}"
        TF_VAR_instance_type             = "${params.INSTANCE_TYPE.trim()}"
        TF_VAR_root_volume_size          = "${params.ROOT_VOLUME_GB.trim()}"

        PIPELINE_TIMEOUT = "${params.JOB_TIMEOUT_SECONDS.trim()}"
    }

    stages {

        stage('Init') {
            steps {
                script {
                    // The workspace persists between builds, and post { always } archives reports/**
                    // even when this build never fetched any: start empty.
                    sh "rm -rf ${RUNNER_DIR}/reports"
                    if (!params.MANIFEST?.trim()) {
                        error('MANIFEST is required: the s3:// URI of allConcepts_manifest.csv.')
                    }
                    if (!params.OUTPUT?.trim()) {
                        error('OUTPUT is required: an empty s3:// prefix for the split layout.')
                    }

                    def base = (params.RUN_ID?.trim()) ?: "adapt-allconcepts-csvloader-${env.BUILD_NUMBER}"
                    env.BASE_RUN_ID = base.replaceAll(/[^A-Za-z0-9._-]/, '-')
                    env.EFFECTIVE_RUN_ID = env.BASE_RUN_ID

                    env.TF_VAR_name_suffix = "adapt-allconcepts-csvloader-${env.BUILD_NUMBER}".replaceAll(/[^A-Za-z0-9-]/, '-')

                    env.IMAGE_TAR = "hpds-etl-runner-${env.BASE_RUN_ID}.tar.gz"
                    env.TF_VAR_image_tar = env.IMAGE_TAR

                    currentBuild.displayName = "#${env.BUILD_NUMBER} adapt-allconcepts-csvloader"
                    echo "manifest: ${params.MANIFEST}"
                    echo "output:   ${params.OUTPUT}"
                    echo "run id:   ${env.BASE_RUN_ID}"
                }
                sh '''
                    set -e
                    echo "--- tool versions ---"
                    make -s -C $RUNNER_DIR ensure-terraform
                    aws --version
                    docker --version
                    jq --version
                    java -version 2>&1 | head -1
                '''
            }
        }

        stage('Build JAR') {
            steps {
                sh "make -C ${RUNNER_DIR} jar SKIP_TESTS=${params.SKIP_TESTS}"
            }
            post {
                always {
                    junit testResults: 'target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        // The guards that need AWS: the output is not under the legacy bucket and is empty, and the role can
        // read object versions of the manifest's bucket. Exit 10 is warnings only.
        stage('Pre-flight') {
            steps {
                script {
                    env.TF_VAR_run_id = env.EFFECTIVE_RUN_ID
                    int rc = sh(script: "cd ${RUNNER_DIR} && ./preflight.sh", returnStatus: true)
                    if (rc == 10) {
                        unstable('Pre-flight found warnings')
                    } else if (rc != 0) {
                        error("Pre-flight failed (rc=${rc})")
                    }
                }
            }
        }

        stage('Package runner image') {
            steps {
                script {
                    // Set first, so a partial upload is still cleaned up in post.
                    env.OWNS_IMAGE = 'true'
                    sh "make -C ${RUNNER_DIR} package IMAGE_TAR=${env.IMAGE_TAR}"
                }
            }
        }

        stage('Provision, run and monitor') {
            steps {
                script {
                    int maxAttempts = params.RETRY_ON_INFRA ? 2 : 1
                    int rc = 1
                    // Must match options { timeout }; see the header.
                    final long BUILD_TIMEOUT_HOURS = 9
                    final long TEARDOWN_MARGIN_SECONDS = 1800
                    final long MIN_RETRY_SECONDS = 600
                    long deadlineMillis = currentBuild.startTimeInMillis + BUILD_TIMEOUT_HOURS * 3600 * 1000
                    long monitorTimeout = Long.parseLong(env.PIPELINE_TIMEOUT)

                    for (int attempt = 1; attempt <= maxAttempts; attempt++) {
                        env.EFFECTIVE_RUN_ID = (attempt == 1) ? env.BASE_RUN_ID : "${env.BASE_RUN_ID}-r${attempt}"
                        env.TF_VAR_run_id = env.EFFECTIVE_RUN_ID
                        env.TF_VAR_name_suffix = "adapt-allconcepts-csvloader-${env.BUILD_NUMBER}-${attempt}".replaceAll(/[^A-Za-z0-9-]/, '-')
                        env.STATE_KEY = "tf_backend/etl-runners/hpds-etl/adapt-allconcepts-csvloader/${env.EFFECTIVE_RUN_ID}.tfstate"

                        echo "Attempt ${attempt}/${maxAttempts} -- run id ${env.EFFECTIVE_RUN_ID} (monitor timeout ${monitorTimeout}s)"

                        sh "make -C ${RUNNER_DIR} init apply STATE_KEY=${env.STATE_KEY}"
                        env.TF_INITIALISED = 'true'

                        withEnv(["PIPELINE_TIMEOUT=${monitorTimeout}"]) {
                            rc = sh(returnStatus: true, script: """
                                cd ${RUNNER_DIR}
                                TF=\$(make -s tf-path)
                                ../common/monitor-runner.sh \
                                  "\$(\$TF -chdir=terraform output -raw instance_id)" \
                                  "\$(\$TF -chdir=terraform output -raw status_s3_uri)" \
                                  "\$(\$TF -chdir=terraform output -raw log_s3_uri)"
                            """)
                        }

                        env.JOB_EXIT_CODE = "${rc}"
                        if (rc != 4 || attempt == maxAttempts) {
                            break
                        }

                        // A retry writes to the same OUTPUT. An exit 4 leaves it empty: nothing is uploaded before
                        // every check passes, and an upload that fails part-way deletes what it had written (if that
                        // cleanup fails the job exits 3, which is not retried, naming the keys left). Checked before
                        // tearing down, so a skipped retry leaves this attempt's reports and state for the stages below.
                        long remaining = (deadlineMillis - System.currentTimeMillis()) / 1000 - 60 - TEARDOWN_MARGIN_SECONDS
                        if (remaining < MIN_RETRY_SECONDS) {
                            echo "Exit 4, but not retrying: only ${remaining}s of the ${BUILD_TIMEOUT_HOURS}h build timeout would be left for the run"
                            break
                        }
                        monitorTimeout = Math.min(Long.parseLong(env.PIPELINE_TIMEOUT), remaining)

                        echo "Exit 4 (INFRASTRUCTURE_ERROR) is retryable -- tearing down and retrying"
                        sh(returnStatus: true, script: "make -C ${RUNNER_DIR} destroy STATE_KEY=${env.STATE_KEY}")
                        sleep time: 60, unit: 'SECONDS'
                    }

                    if (rc != 0) {
                        String meaning = [
                            1  : 'UNKNOWN (unclassified failure)',
                            2  : 'VALIDATION_FAILED (output under the legacy bucket or not empty, a bad parameter, or a manifest/partition name the runner would refuse)',
                            3  : 'DATA_ERROR (md5 mismatch, manifest moved, ids not patient-level, too many rejects, or an empty partition)',
                            4  : 'INFRASTRUCTURE_ERROR (S3/network/disk)',
                            5  : 'CONFIG_ERROR (an input does not exist)',
                            124: 'TIMEOUT (runner did not finish in time)',
                        ].get(rc, "unmapped code ${rc}")
                        env.FAILURE_MEANING = meaning
                        echo "Job exited ${rc}: ${meaning}"
                    }
                }
            }
        }

        stage('Fetch reports') {
            when { expression { env.TF_INITIALISED == 'true' } }
            steps {
                sh "make -C ${RUNNER_DIR} fetch-reports STATE_KEY=${env.STATE_KEY}"
            }
        }

        stage('Validate') {
            when { expression { env.TF_INITIALISED == 'true' } }
            steps {
                script {
                    String reportFile = "${RUNNER_DIR}/reports/adapt-allconcepts-csvloader-${env.EFFECTIVE_RUN_ID}.json"
                    if (env.JOB_EXIT_CODE != '0' && !fileExists(reportFile)) {
                        env.FAILURE_REASON = "${env.FAILURE_MEANING}; it stopped before writing its report, so there was nothing to validate"
                        error("Job failed: ${env.FAILURE_REASON}. The runner log above shows how far it got.")
                    }
                    int rc = sh(returnStatus: true, script:
                        "cd ${RUNNER_DIR} && ./validate.sh reports ${env.EFFECTIVE_RUN_ID}")

                    if (env.JOB_EXIT_CODE != '0') {
                        env.FAILURE_REASON = env.FAILURE_MEANING
                        error("Job failed: ${env.FAILURE_MEANING}. The report checks above show what it recorded.")
                    }
                    if (rc == 10) {
                        unstable('Validation passed with warnings')
                    } else if (rc != 0) {
                        env.FAILURE_REASON = "report validation failed (rc=${rc})"
                        error("Report validation failed (rc=${rc}): the job exited 0 but its output does not hold up")
                    }
                    echo "Adapt allConcepts completed and validated. Next: hpds-pheno-load with FLOWS=csvloader-split SPLIT_URI=${params.OUTPUT}"
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "${RUNNER_DIR}/reports/**",
                             allowEmptyArchive: true, fingerprint: true
            script {
                if (env.TF_INITIALISED == 'true') {
                    int rc = sh(returnStatus: true,
                                script: "make -C ${RUNNER_DIR} destroy STATE_KEY=${env.STATE_KEY}")
                    if (rc != 0) {
                        echo "WARNING: terraform destroy returned ${rc}."
                    }
                }
                // The image this build uploaded.
                if (env.OWNS_IMAGE == 'true') {
                    sh(returnStatus: true, script: """
                        aws s3 rm s3://\$(sed -n 's/^stack_s3_bucket[[:space:]]*=[[:space:]]*"\\(.*\\)"/\\1/p' \
                          etl-runners/environments/${ENV}.tfvars)/etl-runner/container/${env.IMAGE_TAR} \
                          --region ${AWS_REGION} || true
                    """)
                    // The local tarball and image make package left on this host.
                    sh(returnStatus: true, script: '''
                        rm -f "$RUNNER_DIR/$IMAGE_TAR"
                        docker rmi "${IMAGE_TAR%.tar.gz}" >/dev/null 2>&1 || true
                    ''')
                }
            }
        }
        failure {
            script {
                currentBuild.description = env.FAILURE_REASON ?: env.FAILURE_MEANING ?:
                    (env.JOB_EXIT_CODE ? 'the job ran, then a later step failed; see the console' : 'failed before the job ran; see the console')
            }
            echo "adapt-allconcepts-csvloader FAILED: ${currentBuild.description}. Reports are archived on this build."
        }
        unstable {
            echo 'adapt-allconcepts-csvloader completed WITH WARNINGS. Check the report for details.'
        }
        success {
            echo "adapt-allconcepts-csvloader completed (run ${env.EFFECTIVE_RUN_ID})."
        }
    }
}
