// =============================================================================
// PERMANENT -- split-allconcepts-by-consent (JobType.PERMANENT)
//
// Runs one hpds-etl job on a Terraform-provisioned ephemeral EC2 runner that terminates itself
// when the job exits. A single run over the one merged allConcepts CSV (not per study).
//
// What the job does
//   Reads the merged allConcepts CSV (all studies plus global variables such as \_consents\),
//   takes each patient's consent strings from the _consents variable, and writes one
//   <partition>-allConcepts.csv per consent for the partitioned HPDS loader. No database, no
//   patient-id mapping: patient numbers are unchanged. See docs/SPLIT_ALLCONCEPTS_BY_CONSENT.md.
//
// Inputs
//   --input          merged allConcepts CSV     (params.INPUT)
//   --output         output prefix              (params.OUTPUT; blank = <OUTPUT_BASE><run id>/)
//   --depth          study segment of the path  (params.DEPTH)
//   --globals        own | by-patient           (params.GLOBALS)
//   --fence-mapping  coverage cross-check       (params.FENCE_MAPPING; "none" skips)
//   --force          non-empty output prefix    (params.FORCE; forced on infra retries)
//
// Outputs
//   {output}/<partition>-allConcepts.csv   one per consent partition (and per global in 'own')
//   {output}/split_manifest.json           row accounting per partition
//   split-allconcepts-by-consent-<runId>.json   the JobResult (archived)
//
// Never writes under avillach-73-bdcatalyst-etl (the job refuses). Deletes nothing.
//
// Exit codes (see ExitCode.java)
//   0 success | 2 validation | 3 data | 4 infrastructure, retried once | 5 config | 1 unknown
// =============================================================================

pipeline {
    agent any

    tools {
        jdk 'jdk-25'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '30'))
        timeout(time: 8, unit: 'HOURS')
    }

    parameters {
        string(name: 'INPUT',
               defaultValue: 's3://bdc-etl-data-d0d6191/data/transforms/all_concepts_merged/allConcepts_data_analyzer.csv',
               description: '--input: S3 URI of the merged allConcepts CSV')
        string(name: 'OUTPUT',
               defaultValue: '',
               description: '--output: output prefix. Blank uses OUTPUT_BASE + run id + "/". Must be an s3:// URI (or a path under /reports) and must NOT be under avillach-73-bdcatalyst-etl.')
        string(name: 'OUTPUT_BASE',
               defaultValue: 's3://bdc-etl-data-d0d6191/data/transforms/all_concepts_split/',
               description: 'Prefix that the run id is appended to when OUTPUT is blank')
        string(name: 'DEPTH', defaultValue: '1',
               description: '--depth: 0-based concept-path segment naming the study (leading empty segment is 0; BDC = 1)')
        choice(name: 'GLOBALS', choices: ['own', 'by-patient'],
               description: '--globals: own = each non-study node (_consents, _studies, DCC ...) gets its own partition, unreachable until PSAMA grants those names; by-patient = copy global rows into each of the patient\'s consent partitions (works with today\'s auth, larger output)')
        string(name: 'FENCE_MAPPING', defaultValue: '',
               description: '--fence-mapping: fence_mapping.json for the report-only coverage cross-check. Blank = job default (mirrored legacy metadata_new_search.json). "none" skips.')
        booleanParam(name: 'FORCE', defaultValue: false,
               description: '--force: allow a non-empty output prefix (overwrites same-named files, deletes nothing). Always on for the second attempt after an infrastructure failure.')
        string(name: 'RUN_ID', defaultValue: '',
               description: 'Correlation id. Blank uses <UTC timestamp>-<build number>.')
        string(name: 'INSTANCE_TYPE', defaultValue: 'r6i.large',
               description: 'Runner instance type.')
        string(name: 'ROOT_VOLUME_GB', defaultValue: '1000',
               description: 'Runner root disk in GiB. Every output byte is spooled locally before upload: at least 2x the input (more for by-patient). Pre-flight checks this against the input size.')
        string(name: 'JOB_TIMEOUT_SECONDS', defaultValue: '21600',
               description: 'How long to wait for the runner before giving up (monitor exits 124)')
        booleanParam(name: 'SKIP_TESTS', defaultValue: false,
               description: 'Skip the JAR test suites.')
        booleanParam(name: 'RETRY_ON_INFRA', defaultValue: true,
               description: 'Retry once on exit 4 (INFRASTRUCTURE_ERROR).')
        string(name: 'CONTAINER_ASSUME_ROLE_ARN', defaultValue: '',
               description: 'Cross-account IAM role ARN for the container to assume when reading S3. Blank (default) uses the instance role, which is what in-boundary buckets need; the legacy bucket is only read through the nightly mirror.')
        booleanParam(name: 'PREFLIGHT_ONLY', defaultValue: false,
               description: 'Validate the input/output and stop, without provisioning anything')
        choice(name: 'ENV', choices: ['integration'],
               description: 'Target environment. Selects etl-runners/environments/<ENV>.tfvars.')
    }

    environment {
        ENV        = "${params.ENV ?: 'integration'}"
        AWS_REGION = 'us-east-1'

        RUNNER_DIR = 'etl-runners/split-allconcepts-by-consent'

        TF_VAR_input_uri                 = "${params.INPUT.trim()}"
        TF_VAR_depth                     = "${params.DEPTH.trim()}"
        TF_VAR_globals                   = "${params.GLOBALS}"
        TF_VAR_fence_mapping             = "${params.FENCE_MAPPING.trim()}"
        TF_VAR_container_assume_role_arn = "${params.CONTAINER_ASSUME_ROLE_ARN.trim()}"
        TF_VAR_instance_type             = "${params.INSTANCE_TYPE.trim()}"
        TF_VAR_root_volume_size          = "${params.ROOT_VOLUME_GB.trim()}"
        TF_VAR_name_suffix               = "${env.BUILD_NUMBER}"

        PIPELINE_TIMEOUT = "${params.JOB_TIMEOUT_SECONDS.trim()}"
    }

    stages {

        stage('Init') {
            steps {
                script {
                    // Fail fast on paths the container cannot see. A non-s3 value resolves
                    // against the container CWD (/app); only /reports is mounted. Anything
                    // else burns ~20 minutes of provisioning and exits 5 (CONFIG_ERROR).
                    [INPUT: params.INPUT, OUTPUT: params.OUTPUT, FENCE_MAPPING: params.FENCE_MAPPING].each { name, v ->
                        def t = v?.trim()
                        if (t && t != 'none' && !t.startsWith('s3://') && !t.startsWith('/reports')) {
                            error("${name} must be an s3:// URI (or a path under /reports): " +
                                  "'${v}' would resolve inside the runner container and exit 5 (CONFIG_ERROR).")
                        }
                    }

                    def base = params.RUN_ID?.trim()
                    if (!base) {
                        def stamp = sh(returnStdout: true, script: 'date -u +%Y%m%d-%H%M%S').trim()
                        base = "${stamp}-${env.BUILD_NUMBER}"
                    }
                    env.BASE_RUN_ID = base.replaceAll(/[^A-Za-z0-9._-]/, '-')
                    env.EFFECTIVE_RUN_ID = env.BASE_RUN_ID

                    // The output prefix belongs to the logical run, so an infrastructure retry
                    // writes to the same place (with force) instead of a second prefix.
                    def out = params.OUTPUT?.trim()
                    if (!out) {
                        out = "${params.OUTPUT_BASE.trim()}${env.BASE_RUN_ID}/"
                    }
                    env.TF_VAR_output_uri = out
                    env.TF_VAR_force = params.FORCE ? 'true' : 'false'

                    env.IMAGE_TAR = "hpds-etl-runner-${env.BASE_RUN_ID}.tar.gz"
                    env.TF_VAR_image_tar = env.IMAGE_TAR

                    echo "run id:  ${env.BASE_RUN_ID}"
                    echo "input:   ${params.INPUT}"
                    echo "output:  ${out}"
                    echo "depth:   ${params.DEPTH}   globals: ${params.GLOBALS}"
                }
                sh '''
                    set -e
                    echo "--- tool versions ---"
                    make -s -C $RUNNER_DIR ensure-terraform
                    aws --version
                    docker --version
                    jq --version
                    java -version 2>&1 | head -1
                '''
            }
        }

        stage('Build JAR') {
            steps {
                sh "make -C ${RUNNER_DIR} jar SKIP_TESTS=${params.SKIP_TESTS}"
            }
            post {
                always {
                    junit testResults: 'target/surefire-reports/*.xml,target/failsafe-reports/*.xml',
                          allowEmptyResults: true
                }
            }
        }

        stage('Pre-flight') {
            steps {
                script {
                    env.TF_VAR_run_id = env.EFFECTIVE_RUN_ID
                    int rc = sh(script: "cd ${RUNNER_DIR} && ./preflight.sh", returnStatus: true)
                    if (rc == 10) {
                        unstable('Pre-flight found warnings')
                    } else if (rc != 0) {
                        error("Pre-flight failed (rc=${rc})")
                    }
                }
            }
        }

        stage('Package runner image') {
            when { expression { !params.PREFLIGHT_ONLY } }
            steps {
                sh "make -C ${RUNNER_DIR} package IMAGE_TAR=${env.IMAGE_TAR}"
            }
        }

        stage('Provision, run and monitor') {
            when { expression { !params.PREFLIGHT_ONLY } }
            steps {
                script {
                    int maxAttempts = params.RETRY_ON_INFRA ? 2 : 1
                    int rc = 1

                    for (int attempt = 1; attempt <= maxAttempts; attempt++) {
                        env.EFFECTIVE_RUN_ID = (attempt == 1) ? env.BASE_RUN_ID
                                                              : "${env.BASE_RUN_ID}-r${attempt}"
                        env.TF_VAR_run_id = env.EFFECTIVE_RUN_ID
                        env.STATE_KEY = "tf_backend/etl-runners/hpds-etl/split-allconcepts-by-consent/${env.EFFECTIVE_RUN_ID}.tfstate"
                        if (attempt > 1) {
                            // The failed attempt may have uploaded some partitions already.
                            env.TF_VAR_force = 'true'
                        }

                        echo "Attempt ${attempt}/${maxAttempts} -- run id ${env.EFFECTIVE_RUN_ID}"

                        sh "make -C ${RUNNER_DIR} init apply STATE_KEY=${env.STATE_KEY}"
                        env.TF_INITIALISED = 'true'

                        rc = sh(returnStatus: true, script: """
                            cd ${RUNNER_DIR}
                            TF=\$(make -s tf-path)
                            ../common/monitor-runner.sh \
                              "\$(\$TF -chdir=terraform output -raw instance_id)" \
                              "\$(\$TF -chdir=terraform output -raw status_s3_uri)" \
                              "\$(\$TF -chdir=terraform output -raw log_s3_uri)"
                        """)

                        env.JOB_EXIT_CODE = "${rc}"
                        if (rc != 4 || attempt == maxAttempts) {
                            break
                        }

                        echo "Exit 4 (INFRASTRUCTURE_ERROR) is retryable -- tearing down and retrying"
                        sh(returnStatus: true,
                           script: "make -C ${RUNNER_DIR} destroy STATE_KEY=${env.STATE_KEY}")
                        sleep time: 60, unit: 'SECONDS'
                    }

                    if (rc != 0) {
                        String meaning = [
                            1  : 'UNKNOWN (unclassified failure)',
                            2  : 'VALIDATION_FAILED (input rows break the CSVLoader contract, output refused, or row accounting failed)',
                            3  : 'DATA_ERROR (input reachable but malformed)',
                            4  : 'INFRASTRUCTURE_ERROR (S3/network)',
                            5  : 'CONFIG_ERROR (missing or invalid parameter/credential)',
                            124: 'TIMEOUT (runner did not finish in time)',
                        ].get(rc, "unmapped code ${rc}")
                        env.FAILURE_MEANING = meaning
                        echo "Job exited ${rc}: ${meaning}"
                    }
                }
            }
        }

        stage('Fetch reports') {
            when { expression { !params.PREFLIGHT_ONLY && env.TF_INITIALISED == 'true' } }
            steps {
                sh "make -C ${RUNNER_DIR} fetch-reports STATE_KEY=${env.STATE_KEY}"
            }
        }

        stage('Validate') {
            when { expression { !params.PREFLIGHT_ONLY && env.TF_INITIALISED == 'true' } }
            steps {
                script {
                    int rc = sh(returnStatus: true, script:
                        "cd ${RUNNER_DIR} && ./validate.sh reports ${env.EFFECTIVE_RUN_ID}")

                    if (env.JOB_EXIT_CODE != '0') {
                        error("Job failed: ${env.FAILURE_MEANING}. See the validation output above.")
                    }
                    if (rc == 10) {
                        unstable('Validation passed with warnings')
                    } else if (rc != 0) {
                        error("Report validation failed (rc=${rc})")
                    }
                    echo "Split allConcepts validated; partitions are under ${env.TF_VAR_output_uri}"
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "${RUNNER_DIR}/reports/**",
                             allowEmptyArchive: true, fingerprint: true
            script {
                if (env.TF_INITIALISED == 'true') {
                    int rc = sh(returnStatus: true,
                                script: "make -C ${RUNNER_DIR} destroy STATE_KEY=${env.STATE_KEY}")
                    if (rc != 0) {
                        echo "WARNING: terraform destroy returned ${rc}."
                    }
                }
                if (env.IMAGE_TAR) {
                    // Remove this run's image tarball from the deployments bucket (not the data bucket).
                    sh(returnStatus: true, script: """
                        aws s3 rm s3://\$(sed -n 's/^stack_s3_bucket[[:space:]]*=[[:space:]]*"\\(.*\\)"/\\1/p' \
                          etl-runners/environments/${ENV}.tfvars)/etl-runner/container/${env.IMAGE_TAR} \
                          --region ${AWS_REGION} || true
                    """)
                }
            }
        }
        failure {
            echo "split-allconcepts-by-consent FAILED at stage '${env.STAGE_NAME}'. ${env.FAILURE_MEANING ?: ''}"
        }
        unstable {
            echo 'split-allconcepts-by-consent completed WITH WARNINGS.'
        }
        success {
            echo "split-allconcepts-by-consent succeeded (run ${env.EFFECTIVE_RUN_ID}); output ${env.TF_VAR_output_uri}"
        }
    }
}
