// =============================================================================
// TEMPORARY -- participants-migration (JobType.MIGRATION)
//
// Runs one hpds-etl job on a Terraform-provisioned ephemeral EC2 runner that terminates itself
// when the job exits. Triggered by the migration orchestrator's "Migrate participants" stage
// (/Jenkinsfile.migration); also runnable standalone.
//
// Delete this file, its runner directory, and ParticipantsMigrationJob once the migration has run
// in every environment.
//
// What the job does
//   Moves every ready study's participant identities off the legacy system into the
//   participants / consents / samples RDS tables. Per study:
//     - {studyid}_sstr.tsv present: SstrPopulateRdsParticipantsJob loads RDS and this job only
//       resolves legacy-hpds-id -> new-uuid pairs
//     - otherwise: this job populates participants/consents itself, joining
//       {ABV}_PatientMapping.v2.csv against the shared GLOBAL_allConcepts_merged.csv
//   One study's bad data fails that study only, reported as an output-validation error (exit 2).
//
// Inputs
//   --managed-inputs   study list CSV        (params.MANAGED_INPUTS)
//   --data-folder      per-study file folder (params.DATA_FOLDER)
//   --batch-size       rows per batch insert (params.BATCH_SIZE)
//   RDS credentials    fetched on the runner from Secrets Manager by instance role; they never
//                      pass through Jenkins
//
// Outputs
//   RDS rows in participants / consents / samples
//   participants-migration-<runId>.json                       the JobResult
//   sstr-populate-rds-participants-<runId>-<study>-sstr.json   per sstr-routed study
//   <studyId>_hpds_id_mapping.csv                             per succeeded study
//   All archived on this build and left in S3 under the runner's report prefix.
//
// Exit codes (see ExitCode.java)
//   0 success | 2 validation, including a per-study failure | 3 data | 4 infrastructure, retried
//   once | 5 config | 1 unknown | 124 monitor timeout
//
// Agent requirements: JDK 25, Maven wrapper, Docker, Terraform >= 1.3, AWS CLI v2, jq, python3,
// and the jenkins-s3-role instance profile.
// =============================================================================

pipeline {
    agent any

    tools {
        jdk 'jdk-25'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '30'))
        // Two concurrent migrations would write the same RDS tables from different
        // snapshots of the legacy export. Never allow it.
        disableConcurrentBuilds()
        timeout(time: 4, unit: 'HOURS')
    }

    parameters {
        string(name: 'MANAGED_INPUTS',
               defaultValue: 's3://avillach-73-bdcatalyst-etl/__migration__/managed_inputs.csv',
               description: '--managed-inputs: CSV with columns "Study Abbreviated Name", "Study Identifier", "Data is ready to process"')
        string(name: 'DATA_FOLDER',
               defaultValue: 's3://avillach-73-bdcatalyst-etl/__migration__/current',
               description: '--data-folder: folder holding {studyid}_sstr.tsv, {ABV}_PatientMapping.v2.csv, and the shared GLOBAL_allConcepts_merged.csv')
        string(name: 'BATCH_SIZE', defaultValue: '1000',
               description: '--batch-size: rows per batch insert')
        string(name: 'RUN_ID', defaultValue: '',
               description: 'Correlation id. Blank uses a sanitised BUILD_TAG. Appears in the report filename and the S3 report prefix.')
        string(name: 'INSTANCE_TYPE', defaultValue: 'r6i.large',
               description: 'Runner instance type. Memory-bound: a study mapping file and GLOBAL_allConcepts_merged.csv are joined in memory.')
        string(name: 'JOB_TIMEOUT_SECONDS', defaultValue: '7200',
               description: 'How long to wait for the runner before giving up (monitor exits 124)')
        booleanParam(name: 'SKIP_TESTS', defaultValue: false,
               description: 'Skip the JAR test suites. Off by default: the image the runner executes should be the artifact the tests ran against.')
        booleanParam(name: 'RETRY_ON_INFRA', defaultValue: true,
               description: 'Retry once on exit 4 (INFRASTRUCTURE_ERROR). Safe: loads are transactional and upserts are idempotent.')
        string(name: 'CONTAINER_ASSUME_ROLE_ARN', defaultValue: 'arn:aws:iam::736265540791:role/dbgap-etl',
               description: 'Cross-account IAM role ARN for the container to assume when reading S3 inputs. Blank disables cross-account access.')
        booleanParam(name: 'PREFLIGHT_ONLY', defaultValue: false,
               description: 'Validate the input layout and stop, without provisioning anything')
        choice(name: 'ENV', choices: ['integration'],
               description: 'Target environment. Selects etl-runners/environments/<ENV>.tfvars.')
    }

    environment {
        ENV             = "${params.ENV ?: 'integration'}"
        AWS_REGION      = 'us-east-1'
        AWS_CONFIG_FILE = "${WORKSPACE}/.aws-config"

        RUNNER_DIR = 'etl-runners/participants-migration'

        // Terraform reads TF_VAR_* natively, so job parameters never appear on a command
        // line (and so never in `ps` output or the console log's shell echo).
        TF_VAR_managed_inputs_uri        = "${params.MANAGED_INPUTS}"
        TF_VAR_data_folder_uri           = "${params.DATA_FOLDER}"
        TF_VAR_batch_size                = "${params.BATCH_SIZE}"
        TF_VAR_container_assume_role_arn = "${params.CONTAINER_ASSUME_ROLE_ARN}"
        TF_VAR_instance_type             = "${params.INSTANCE_TYPE}"
        TF_VAR_name_suffix        = "${env.BUILD_NUMBER}"

        PIPELINE_TIMEOUT = "${params.JOB_TIMEOUT_SECONDS}"
    }

    stages {

        stage('Init') {
            steps {
                sh '''
                    cat > "$AWS_CONFIG_FILE" <<'EOF'
[profile dbgap-etl]
role_arn = arn:aws:iam::736265540791:role/dbgap-etl
credential_source = Ec2InstanceMetadata
role_session_name = jenkins-hpds-etl
EOF
                '''
                script {
                    // BUILD_TAG can contain '/' for folder or multibranch jobs, and this
                    // value becomes both a filename and an S3 key.
                    def base = (params.RUN_ID?.trim()) ?: env.BUILD_TAG
                    env.BASE_RUN_ID = base.replaceAll(/[^A-Za-z0-9._-]/, '-')
                    env.EFFECTIVE_RUN_ID = env.BASE_RUN_ID

                    // Per-build image tarball: a shared name would let a concurrent build of
                    // the permanent pipeline replace this JAR between upload and boot.
                    env.IMAGE_TAR = "hpds-etl-runner-${env.BASE_RUN_ID}.tar.gz"
                    env.TF_VAR_image_tar = env.IMAGE_TAR

                    echo "run id: ${env.BASE_RUN_ID}"
                    echo "image:  ${env.IMAGE_TAR}"
                }
                sh '''
                    set -e
                    echo "--- tool versions ---"
                    make -s -C $RUNNER_DIR ensure-terraform
                    aws --version
                    docker --version
                    jq --version
                    python3 --version
                    java -version 2>&1 | head -1
                '''
            }
        }

        stage('Build JAR') {
            steps {
                // `package` runs the unit suites; a failing test must stop the run before
                // any infrastructure exists. The Testcontainers *IT suites bind on `verify`
                // and are gated by the orchestrator (/Jenkinsfile) instead, so a standalone
                // re-run of one job does not pay for Docker-backed Postgres and LocalStack.
                sh "make -C ${RUNNER_DIR} jar SKIP_TESTS=${params.SKIP_TESTS}"
            }
            post {
                always {
                    junit testResults: 'target/surefire-reports/*.xml,target/failsafe-reports/*.xml',
                          allowEmptyResults: true
                }
            }
        }

        stage('Pre-flight') {
            steps {
                script {
                    // Called directly, not through make: make collapses every failure to 2
                    // and would lose the validator's "10 = warnings" signal.
                    env.TF_VAR_run_id = env.EFFECTIVE_RUN_ID
                    withEnv(['AWS_PROFILE=dbgap-etl']) {
                        int rc = sh(script: "cd ${RUNNER_DIR} && ./preflight.sh", returnStatus: true)
                        if (rc == 10) {
                            unstable('Pre-flight found warnings in the input layout')
                        } else if (rc != 0) {
                            error("Pre-flight failed (rc=${rc}): the input layout would fail studies at run time")
                        }
                    }
                }
            }
        }

        stage('Package runner image') {
            when { expression { !params.PREFLIGHT_ONLY } }
            steps {
                sh "make -C ${RUNNER_DIR} package IMAGE_TAR=${env.IMAGE_TAR}"
            }
        }

        stage('Provision, run and monitor') {
            when { expression { !params.PREFLIGHT_ONLY } }
            steps {
                script {
                    int maxAttempts = params.RETRY_ON_INFRA ? 2 : 1
                    int rc = 1

                    for (int attempt = 1; attempt <= maxAttempts; attempt++) {
                        // A retry needs its own run id: the previous attempt's status.json
                        // sentinel is still in S3, and the monitor would read it instantly.
                        env.EFFECTIVE_RUN_ID = (attempt == 1) ? env.BASE_RUN_ID
                                                              : "${env.BASE_RUN_ID}-r${attempt}"
                        env.TF_VAR_run_id = env.EFFECTIVE_RUN_ID
                        env.STATE_KEY = "tf_backend/etl-runners/hpds-etl/participants-migration/${env.EFFECTIVE_RUN_ID}.tfstate"

                        echo "Attempt ${attempt}/${maxAttempts} -- run id ${env.EFFECTIVE_RUN_ID}"

                        sh "make -C ${RUNNER_DIR} init apply STATE_KEY=${env.STATE_KEY}"
                        env.TF_INITIALISED = 'true'

                        rc = sh(returnStatus: true, script: """
                            cd ${RUNNER_DIR}
                            TF=\$(make -s tf-path)
                            ../common/monitor-runner.sh \
                              "\$(\$TF -chdir=terraform output -raw instance_id)" \
                              "\$(\$TF -chdir=terraform output -raw status_s3_uri)" \
                              "\$(\$TF -chdir=terraform output -raw log_s3_uri)"
                        """)

                        env.JOB_EXIT_CODE = "${rc}"
                        if (rc != 4 || attempt == maxAttempts) {
                            break
                        }

                        echo "Exit 4 (INFRASTRUCTURE_ERROR) is retryable -- tearing down and retrying"
                        sh(returnStatus: true,
                           script: "make -C ${RUNNER_DIR} destroy STATE_KEY=${env.STATE_KEY}")
                        sleep time: 60, unit: 'SECONDS'
                    }

                    // Reports are fetched and archived even on failure -- a failed run's
                    // report is the only place the reason is written down.
                    if (rc != 0) {
                        String meaning = [
                            1  : 'UNKNOWN (unclassified failure)',
                            2  : 'VALIDATION_FAILED (input/output validation, incl. a per-study failure)',
                            3  : 'DATA_ERROR (input reachable but malformed)',
                            4  : 'INFRASTRUCTURE_ERROR (RDS/S3/network)',
                            5  : 'CONFIG_ERROR (missing or invalid parameter/credential)',
                            124: 'TIMEOUT (runner did not finish in time)',
                        ].get(rc, "unmapped code ${rc}")
                        env.FAILURE_MEANING = meaning
                        echo "Job exited ${rc}: ${meaning}"
                    }
                }
            }
        }

        stage('Fetch reports') {
            when { expression { !params.PREFLIGHT_ONLY && env.TF_INITIALISED == 'true' } }
            steps {
                sh "make -C ${RUNNER_DIR} fetch-reports STATE_KEY=${env.STATE_KEY}"
            }
        }

        stage('Validate') {
            when { expression { !params.PREFLIGHT_ONLY && env.TF_INITIALISED == 'true' } }
            steps {
                script {
                    int rc = sh(returnStatus: true, script:
                        "cd ${RUNNER_DIR} && ./validate.sh reports ${env.EFFECTIVE_RUN_ID}")

                    // The job's exit code and the report assertions are independent gates:
                    // exit 0 with an unexpected mapping-file count is still a failed run.
                    if (env.JOB_EXIT_CODE != '0') {
                        error("Job failed: ${env.FAILURE_MEANING}. See the validation output above.")
                    }
                    if (rc == 10) {
                        unstable('Validation passed with warnings')
                    } else if (rc != 0) {
                        error("Report validation failed (rc=${rc}): the job exited 0 but its output does not hold up")
                    }
                    echo 'Migration validated: every ready study loaded, one mapping file each, no duplicate legacy ids.'
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "${RUNNER_DIR}/reports/**",
                             allowEmptyArchive: true, fingerprint: true
            script {
                if (env.TF_INITIALISED == 'true') {
                    // The instance self-terminates, so this only reclaims the Terraform
                    // state and the instance profile -- never fatal.
                    int rc = sh(returnStatus: true,
                                script: "make -C ${RUNNER_DIR} destroy STATE_KEY=${env.STATE_KEY}")
                    if (rc != 0) {
                        echo "WARNING: terraform destroy returned ${rc}. The runner terminates itself, " +
                             "but check for a leftover instance profile: " +
                             "participants-migration-etl-instance-profile-${env.BUILD_NUMBER}"
                    }
                }
                // Don't leave per-build images in the deployment bucket.
                if (env.IMAGE_TAR) {
                    sh(returnStatus: true, script: """
                        aws s3 rm s3://\$(sed -n 's/^stack_s3_bucket[[:space:]]*=[[:space:]]*"\\(.*\\)"/\\1/p' \
                          etl-runners/environments/${ENV}.tfvars)/etl-runner/container/${env.IMAGE_TAR} \
                          --region ${AWS_REGION} || true
                    """)
                }
            }
        }
        failure {
            echo "participants-migration FAILED at stage '${env.STAGE_NAME}'. " +
                 "${env.FAILURE_MEANING ?: ''} Reports for run ${env.EFFECTIVE_RUN_ID} are archived on this build; " +
                 "the full runner log is in S3 under etl-runner/logs/participants-migration-${env.EFFECTIVE_RUN_ID}.log"
        }
        unstable {
            echo "participants-migration completed WITH WARNINGS. Review the validation output: " +
                 "warnings mean rows were skipped or a study reported something unexpected."
        }
        success {
            echo "participants-migration succeeded (run ${env.EFFECTIVE_RUN_ID})."
        }
    }
}
